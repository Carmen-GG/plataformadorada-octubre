# URL /exec de la aplicación web de Google Apps Script que devuelve
# exclusivamente el número agregado de adhesiones.
VITE_ADHESION_COUNT_URL=

# URL /exec de la aplicación web de Google Apps Script que recibe el
# formulario de contacto y envía el mensaje a plataformadoradaes@gmail.com.
VITE_CONTACT_FORM_URL=

# El mismo Web App de Apps Script sirve el contador, noticias y recursos.
# El backoffice se abre con: <URL>/exec?view=admin

# Dirección pública de la web (sin barra final), p. ej. https://plataformadorada.es
# Se usa para URLs canónicas, imagen al compartir en redes, sitemap.xml y datos estructurados.
VITE_SITE_URL=
